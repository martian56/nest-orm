import std/env { get_env_or, has_env }
import std/string
import std/test { assert_eq_int, assert_eq_str, assert_msg, assert_true }
import "github.com/martian56/raven-mysql" { connect as connect_mysql }
import "github.com/martian56/raven-postgres" { connect as connect_postgres }
import std/error { error_kind }
import "github.com/martian56/raven-sqlite" { Db as SqliteDb }
import "./lib" { Executor, QueryResult, Value, delete_all, delete_from, fetch_all, insert_into, insert_one, integer, null, raw_query, select, text, transaction, update, update_all }
import "./migrations" { Migration, migrate, migration, rollback_last }
import "./mysql" { MySql, mysql, mysql_no_backslash_escapes }
import "./postgres" { Postgres, postgres }
import "./sqlite" { Sqlite, sqlite }

fun must_result<T>(result: Result<T, Error>) -> T {
    return match result {
        Ok(value) -> value,
        Err(e) -> {
            __panic(e.message())
            must_result(result)
        },
    }
}

fun must_open_sqlite(path: String) -> SqliteDb {
    return match SqliteDb.open(path) {
        Ok(db) -> db,
        Err(message) -> {
            __panic(message)
            must_open_sqlite(path)
        },
    }
}

fun string_or(value: Option<String>, fallback: String) -> String {
    return match value {
        Some(inner) -> inner,
        None -> fallback,
    }
}

fun probe_migrations() -> List<Migration> {
    return [
        migration(1001, "create probe").up(
            "CREATE TABLE nest_migration_probe (id BIGINT PRIMARY KEY)",
        ).down("DROP TABLE nest_migration_probe"),
    ]
}

fun verify_live_migrations<T: Executor>(db: T) {
    let report = must_result(migrate(db, probe_migrations()))
    assert_eq_int(report.applied.len(), 1)
    assert_eq_int(report.applied[0], 1001)
    let repeated = must_result(migrate(db, probe_migrations()))
    assert_eq_int(repeated.applied.len(), 0)
    assert_eq_int(repeated.skipped, 1)
    let rolled_back = must_result(rollback_last(db, probe_migrations()))
    match rolled_back.rolled_back {
        Some(version) -> assert_eq_int(version, 1001),
        None -> assert_msg(false, "expected live migration to roll back"),
    }
}

fun test_transaction_commits_and_rolls_back() {
    let connection = must_open_sqlite(":memory:")
    match connection.exec(
        "CREATE TABLE accounts (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL)",
    ) {
        Ok(_) -> {},
        Err(message) -> __panic(message),
    }
    let db = sqlite(connection)

    // Commit path: the inserted row is visible after the transaction returns Ok.
    let _committed = must_result(
        transaction(
            db,
            fun(tx: Sqlite) -> Result<QueryResult, Error> = insert_one(
                tx,
                insert_into("accounts").value("name", text("Ada")),
            ),
        ),
    )
    assert_eq_int(must_result(fetch_all(db, select("accounts"))).row_count(), 1)

    // Rollback path: the body inserts a row and then yields Err, so the write
    // is undone and the row count stays at one.
    let outcome = transaction(
        db,
        fun(tx: Sqlite) -> Result<QueryResult, Error> = match insert_one(
            tx,
            insert_into("accounts").value("name", text("Grace")),
        ) {
            Ok(_) -> Err(error_kind("test", "boom")),
            Err(inner) -> Err(inner),
        },
    )
    match outcome {
        Ok(_) -> assert_msg(false, "transaction should have failed"),
        Err(_) -> assert_true(true),
    }
    assert_eq_int(must_result(fetch_all(db, select("accounts"))).row_count(), 1)
}

fun test_sqlite_adapter_crud_end_to_end() {
    let connection = must_open_sqlite(":memory:")
    match connection.exec(
        "CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, nickname TEXT NULL)",
    ) {
        Ok(changed) -> {},
        Err(message) -> __panic(message),
    }
    let db = sqlite(connection)

    let first = must_result(
        insert_one(db, insert_into("users").value("name", text("Ada")).value("nickname", null())),
    )
    assert_eq_int(first.affected, 1)
    assert_eq_int(first.last_insert_id, 1)
    let second = must_result(
        insert_one(
            db,
            insert_into("users").value("name", text("Grace")).value(
                "nickname",
                text("Amazing Grace"),
            ),
        ),
    )
    assert_eq_int(second.last_insert_id, 2)

    let users = must_result(
        fetch_all(
            db,
            select("users").column("id").column("name").column("nickname").order_asc("id"),
        ),
    )
    assert_eq_int(users.row_count(), 2)
    assert_eq_str(string_or(users.rows[0].get_named("name"), "missing"), "Ada")
    assert_true(users.rows[0].is_null_named("nickname"))
    assert_eq_str(users.rows[1].get(2), "Amazing Grace")

    let updated = must_result(
        update_all(db, update("users").set("nickname", text("Countess")).where_eq("id", integer(1))),
    )
    assert_eq_int(updated.affected, 1)
    let ada = must_result(
        fetch_all(db, select("users").column("nickname").where_eq("id", integer(1))),
    )
    assert_eq_str(ada.rows[0].get(0), "Countess")

    let deleted = must_result(delete_all(db, delete_from("users").where_eq("id", integer(2))))
    assert_eq_int(deleted.affected, 1)
    assert_eq_int(must_result(fetch_all(db, select("users").column("id"))).row_count(), 1)
    db.close()
}

fun test_sqlite_adapter_keeps_hostile_values_out_of_sql() {
    let connection = must_open_sqlite(":memory:")
    let _ = connection.exec("CREATE TABLE notes (body TEXT NOT NULL)")
    let db = sqlite(connection)
    let hostile = "'); DROP TABLE notes; --"
    let _ = must_result(insert_one(db, insert_into("notes").value("body", text(hostile))))
    let notes = must_result(
        fetch_all(db, select("notes").column("body").where_eq("body", text(hostile))),
    )
    assert_eq_int(notes.row_count(), 1)
    assert_eq_str(notes.rows[0].get(0), hostile)
    db.close()
}

fun test_sqlite_adapter_surfaces_failures_and_remains_reusable() {
    let connection = must_open_sqlite(":memory:")
    let _ = connection.exec(
        "CREATE TABLE unique_users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE)",
    )
    let db = sqlite(connection)
    let _ = must_result(insert_one(db, insert_into("unique_users").value("name", text("Ada"))))

    match insert_one(db, insert_into("unique_users").value("name", text("Ada"))) {
        Ok(_) -> assert_msg(false, "duplicate value unexpectedly succeeded"),
        Err(e) -> assert_msg(e.message().contains("UNIQUE"), e.message()),
    }

    let no_params: List<Option<String>> = []
    let one_column: List<String> = ["value"]
    match db.run(raw_query("SELECT ?", no_params, one_column, true)) {
        Ok(_) -> assert_msg(false, "wrong parameter count unexpectedly succeeded"),
        Err(e) -> assert_msg(e.message().contains("expected 1 parameters"), e.message()),
    }

    // Both failures finalize their statements, so the same connection can be
    // used immediately and closed cleanly.
    assert_eq_int(must_result(fetch_all(db, select("unique_users"))).row_count(), 1)
    let discover_columns: List<String> = []
    let discovered = must_result(
        db.run(raw_query("SELECT 7 AS answer", no_params, discover_columns, true)),
    )
    assert_eq_str(string_or(discovered.rows[0].get_named("answer"), "missing"), "7")
    let _ = must_result(db.try_close())
}

fun test_sqlite_returning_and_empty_membership_end_to_end() {
    let connection = must_open_sqlite(":memory:")
    let _ = connection.exec(
        "CREATE TABLE people (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL)",
    )
    let db = sqlite(connection)
    let inserted = must_result(
        insert_one(
            db,
            insert_into("people").value("name", text("Ada")).returning("id").returning("name"),
        ),
    )
    assert_eq_str(string_or(inserted.rows[0].get_named("id"), "missing"), "1")
    assert_eq_str(string_or(inserted.rows[0].get_named("name"), "missing"), "Ada")
    let _ = must_result(insert_one(db, insert_into("people").value("name", text("Grace"))))

    let none: List<Value> = []
    assert_eq_int(must_result(fetch_all(db, select("people").where_in("id", none))).row_count(), 0)
    assert_eq_int(
        must_result(fetch_all(db, select("people").where_not_in("id", none))).row_count(),
        2,
    )
    let _ = must_result(db.try_close())
}

fun postgres_port() -> Int {
    return match get_env_or("NEST_POSTGRES_PORT", "55433").parse_int() {
        Some(port) -> port,
        None -> 55433,
    }
}

fun mysql_port() -> Int {
    return match get_env_or("NEST_MYSQL_PORT", "33307").parse_int() {
        Some(port) -> port,
        None -> 33307,
    }
}

fun test_postgres_adapter_end_to_end() {
    if !has_env("NEST_POSTGRES_E2E") {
        return
    }
    let connection = must_result(
        connect_postgres(
            "127.0.0.1",
            postgres_port(),
            get_env_or("NEST_POSTGRES_USER", "raven"),
            get_env_or("NEST_POSTGRES_PASSWORD", "ravenpw"),
            get_env_or("NEST_POSTGRES_DATABASE", "ravendb"),
        ),
    )
    let _ = must_result(connection.execute("DROP TABLE IF EXISTS nest_users"))
    let _ = must_result(
        connection.execute(
            "CREATE TABLE nest_users (id BIGSERIAL PRIMARY KEY, name TEXT NOT NULL, nickname TEXT NULL)",
        ),
    )
    let db = postgres(connection)
    let inserted = must_result(
        insert_one(
            db,
            insert_into("nest_users").value("name", text("Ada")).value("nickname", null()).returning(
                "id",
            ).returning("name"),
        ),
    )
    assert_eq_int(inserted.affected, 1)
    assert_eq_str(string_or(inserted.rows[0].get_named("id"), "missing"), "1")
    assert_eq_str(string_or(inserted.rows[0].get_named("name"), "missing"), "Ada")
    let rows = must_result(
        fetch_all(
            db,
            select("nest_users").column("id").column("name").column("nickname").where_eq(
                "name",
                text("Ada"),
            ),
        ),
    )
    assert_eq_int(rows.row_count(), 1)
    assert_eq_str(string_or(rows.rows[0].get_named("name"), "missing"), "Ada")
    assert_true(rows.rows[0].is_null_named("nickname"))
    let _ = must_result(
        transaction(
            db,
            fun(tx: Postgres) -> Result<QueryResult, Error> = insert_one(
                tx,
                insert_into("nest_users").value("name", text("Grace")),
            ),
        ),
    )
    match transaction(
        db,
        fun(tx: Postgres) -> Result<QueryResult, Error> = match insert_one(
            tx,
            insert_into("nest_users").value("name", text("Hopper")),
        ) {
            Ok(_) -> Err(error_kind("test", "rollback")),
            Err(inner) -> Err(inner),
        },
    ) {
        Ok(_) -> assert_msg(false, "PostgreSQL rollback transaction unexpectedly succeeded"),
        Err(_) -> assert_true(true),
    }
    assert_eq_int(must_result(fetch_all(db, select("nest_users"))).row_count(), 2)
    let _ = must_result(delete_all(db, delete_from("nest_users").where_eq("name", text("Ada"))))
    verify_live_migrations(db)
    let _ = must_result(db.connection.execute("DROP TABLE nest_users"))
    db.close()
}

fun test_mysql_adapter_end_to_end() {
    if !has_env("NEST_MYSQL_E2E") {
        return
    }
    let connection = must_result(
        connect_mysql(
            "127.0.0.1",
            mysql_port(),
            get_env_or("NEST_MYSQL_USER", "raven"),
            get_env_or("NEST_MYSQL_PASSWORD", "ravenpw"),
            get_env_or("NEST_MYSQL_DATABASE", "ravendb"),
        ),
    )
    let _ = must_result(connection.execute("DROP TABLE IF EXISTS nest_users"))
    let _ = must_result(
        connection.execute(
            "CREATE TABLE nest_users (id BIGINT PRIMARY KEY AUTO_INCREMENT, name VARCHAR(100) NOT NULL, nickname VARCHAR(100) NULL)",
        ),
    )
    let db = mysql(connection)
    let inserted = must_result(
        insert_one(
            db,
            insert_into("nest_users").value("name", text("Ada")).value("nickname", null()),
        ),
    )
    assert_eq_int(inserted.affected, 1)
    assert_eq_int(inserted.last_insert_id, 1)
    let rows = must_result(
        fetch_all(
            db,
            select("nest_users").column("id").column("name").column("nickname").where_eq(
                "name",
                text("Ada"),
            ),
        ),
    )
    assert_eq_int(rows.row_count(), 1)
    assert_eq_str(string_or(rows.rows[0].get_named("name"), "missing"), "Ada")
    assert_true(rows.rows[0].is_null_named("nickname"))
    let _ = must_result(
        update_all(db, update("nest_users").set("name", text("Augusta")).where_eq("id", integer(1))),
    )
    assert_eq_str(
        must_result(fetch_all(db, select("nest_users").column("name").where_eq("id", integer(1)))).rows[0].get(
            0,
        ),
        "Augusta",
    )
    let _ = must_result(
        transaction(
            db,
            fun(tx: MySql) -> Result<QueryResult, Error> = insert_one(
                tx,
                insert_into("nest_users").value("name", text("Grace")),
            ),
        ),
    )
    match transaction(
        db,
        fun(tx: MySql) -> Result<QueryResult, Error> = match insert_one(
            tx,
            insert_into("nest_users").value("name", text("Hopper")),
        ) {
            Ok(_) -> Err(error_kind("test", "rollback")),
            Err(inner) -> Err(inner),
        },
    ) {
        Ok(_) -> assert_msg(false, "MySQL rollback transaction unexpectedly succeeded"),
        Err(_) -> assert_true(true),
    }
    assert_eq_int(must_result(fetch_all(db, select("nest_users"))).row_count(), 2)

    let _ = must_result(db.connection.execute("SET SESSION sql_mode = 'NO_BACKSLASH_ESCAPES'"))
    let mode_db = mysql_no_backslash_escapes(db.connection)
    let raw_params: List<Option<String>> = [Some("safe")]
    let raw_columns: List<String> = ["literal_value", "bound_value"]
    let raw = must_result(
        mode_db.run(
            raw_query(
                "SELECT 'backslash\\' AS literal_value, ? AS bound_value",
                raw_params,
                raw_columns,
                true,
            ),
        ),
    )
    assert_eq_str(raw.rows[0].get(0), "backslash\\")
    assert_eq_str(raw.rows[0].get(1), "safe")
    verify_live_migrations(db)
    let _ = must_result(db.connection.execute("DROP TABLE nest_users"))
    db.close()
}
