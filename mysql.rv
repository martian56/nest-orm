// MySQL adapter for Nest.

import "github.com/martian56/raven-mysql" { Connection as MySqlConnection, QueryResult as MySqlQueryResult }
import "./lib" { CompiledQuery, Dialect, Executor, QueryResult as NestQueryResult, Row as NestRow }

struct MySql {
    connection: MySqlConnection,
    no_backslash_escapes: Bool,
}

fun mysql(connection: MySqlConnection) -> MySql {
    return MySql { connection, no_backslash_escapes: false }
}

// Use this adapter when the connection's session SQL mode contains
// NO_BACKSLASH_ESCAPES so raw SQL strings are scanned with matching rules.
fun mysql_no_backslash_escapes(connection: MySqlConnection) -> MySql {
    return MySql { connection, no_backslash_escapes: true }
}

impl MySql {
    fun close(self) {
        self.connection.close()
    }
}

impl Executor for MySql {
    fun dialect(self) -> Dialect = Dialect.MySql

    fun run(self, query: CompiledQuery) -> Result<NestQueryResult, Error> {
        let result = if self.no_backslash_escapes {
            self.connection.query_optional_params_no_backslash_escapes(query.sql, query.params)?
        } else {
            self.connection.query_optional_params(query.sql, query.params)?
        }
        return Ok(mysql_result(result))
    }
}

fun mysql_result(result: MySqlQueryResult) -> NestQueryResult {
    let rows: List<NestRow> = []
    for row in result.rows {
        rows.push(
            NestRow {
                columns: result.columns,
                values: row.values,
                nulls: row.nulls,
            },
        )
    }
    return NestQueryResult {
        columns: result.columns,
        rows,
        affected: result.affected,
        last_insert_id: result.last_insert_id,
    }
}
