// Versioned migrations for every Nest Executor.

from std.error import error_kind
import std.string
from "./lib" import (
    CompiledQuery,
    Dialect,
    Executor,
    QueryResult,
    Row,
    delete_all,
    delete_from,
    insert_into,
    insert_one,
    integer,
    raw_query,
    text,
)

class Migration {
    version: int
    name: str
    up_statements: list[str]
    down_statements: list[str]
}

fun migration(version: int, name: str) -> Migration {
    let up_statements: list[str] = []
    let down_statements: list[str] = []
    return Migration(
        version: version,
        name: name,
        up_statements: up_statements,
        down_statements: down_statements,
    )
}

impl Migration {
    fun up(self, sql: str) -> Migration {
        self.up_statements.push(sql)
        return self
    }

    fun down(self, sql: str) -> Migration {
        self.down_statements.push(sql)
        return self
    }
}

class AppliedMigration {
    version: int
    name: str
}

class MigrationReport {
    applied: list[int]
    skipped: int
}

class RollbackReport {
    rolled_back: Option[int]
}

fun empty_params() -> list[Option[str]] {
    let params: list[Option[str]] = []
    return params
}

fun empty_columns() -> list[str] {
    let columns: list[str] = []
    return columns
}

fun run_sql[T: Executor](executor: T, sql: str) -> Result[QueryResult, Error] {
    return executor.run(raw_query(sql, empty_params(), empty_columns(), false))
}

fun ensure_migration_table[T: Executor](executor: T) -> Result[QueryResult, Error] {
    return run_sql(
        executor,
        "CREATE TABLE IF NOT EXISTS nest_migrations (version BIGINT PRIMARY KEY, name VARCHAR(255) NOT NULL)",
    )
}

fun validate_migrations(migrations: list[Migration]) -> Result[bool, Error] {
    var previous = 0
    for item in migrations {
        if item.version <= 0 {
            return Err(error_kind("nest", "migration versions must be positive"))
        }
        if item.version <= previous {
            return Err(error_kind("nest", "migrations must be ordered by unique, increasing versions"))
        }
        if item.name.length() == 0 {
            return Err(error_kind("nest", "migration names cannot be empty"))
        }
        if item.up_statements.len() == 0 {
            return Err(error_kind("nest", "migration ${item.version} has no up statements"))
        }
        previous = item.version
    }
    return Ok(true)
}

fun parse_migration_version(value: str) -> Result[int, Error] {
    return match value.parse_int() {
        case Some(version) { Ok(version) }
        case None { Err(error_kind("nest", "invalid version in nest_migrations")) }
    }
}

fun applied_migrations[T: Executor](executor: T) -> Result[list[AppliedMigration], Error] {
    let columns: list[str] = ["version", "name"]
    let result = executor.run(
        raw_query(
            "SELECT version, name FROM nest_migrations ORDER BY version ASC",
            empty_params(),
            columns,
            true,
        ),
    )?
    let applied: list[AppliedMigration] = []
    for row in result.rows {
        let version = parse_migration_version(row.get(0))?
        applied.push(AppliedMigration(version: version, name: row.get(1)))
    }
    return Ok(applied)
}

fun contains_version(applied: list[AppliedMigration], version: int) -> bool {
    for item in applied {
        if item.version == version {
            return true
        }
    }
    return false
}

fun validate_applied_history(
    applied: list[AppliedMigration],
    migrations: list[Migration],
) -> Result[bool, Error] {
    for record in applied {
        match find_migration(migrations, record.version) {
            case Some(item) {
                if item.name != record.name {
                    return Err(
                        error_kind(
                            "nest",
                            "migration ${record.version} is named '${record.name}' in the database but '${item.name}' in code",
                        ),
                    )
                }
            }
            case None {
                return Err(
                    error_kind(
                        "nest",
                        "applied migration ${record.version} is missing from the migration list",
                    ),
                )
            }
        }
    }
    return Ok(true)
}

fun transactional_ddl(dialect: Dialect) -> bool {
    return match dialect {
        case Postgres { true }
        case Sqlite { true }
        case MySql { false }
    }
}

fun rollback_quietly[T: Executor](executor: T) {
    let _ = run_sql(executor, "ROLLBACK")
}

fun apply_one[T: Executor](executor: T, item: Migration) -> Result[bool, Error] {
    let transactional = transactional_ddl(executor.dialect())
    if transactional {
        let _ = run_sql(executor, "BEGIN")?
    }
    for statement in item.up_statements {
        match run_sql(executor, statement) {
            case Ok(result) {}
            case Err(e) {
                if transactional {
                    rollback_quietly(executor)
                }
                return Err(e)
            }
        }
    }
    match insert_one(
        executor,
        insert_into("nest_migrations").value("version", integer(item.version)).value(
            "name",
            text(item.name),
        ),
    ) {
        case Ok(result) {}
        case Err(e) {
            if transactional {
                rollback_quietly(executor)
            }
            return Err(e)
        }
    }
    if transactional {
        let _ = run_sql(executor, "COMMIT")?
    }
    return Ok(true)
}

fun migrate[T: Executor](
    executor: T,
    migrations: list[Migration],
) -> Result[MigrationReport, Error] {
    let _ = validate_migrations(migrations)?
    let _ = ensure_migration_table(executor)?
    let applied_before = applied_migrations(executor)?
    let _ = validate_applied_history(applied_before, migrations)?
    let applied: list[int] = []
    var skipped = 0
    for item in migrations {
        if contains_version(applied_before, item.version) {
            skipped = skipped + 1
        } else {
            let _ = apply_one(executor, item)?
            applied.push(item.version)
        }
    }
    return Ok(MigrationReport(applied: applied, skipped: skipped))
}

fun find_migration(migrations: list[Migration], version: int) -> Option[Migration] {
    for item in migrations {
        if item.version == version {
            return Some(item)
        }
    }
    return None
}

fun require_migration(migrations: list[Migration], version: int) -> Result[Migration, Error] {
    return match find_migration(migrations, version) {
        case Some(value) { Ok(value) }
        case None {
            Err(error_kind("nest", "applied migration ${version} is missing from the migration list"))
        }
    }
}

fun rollback_one[T: Executor](executor: T, item: Migration) -> Result[bool, Error] {
    if item.down_statements.len() == 0 {
        return Err(error_kind("nest", "migration ${item.version} has no down statements"))
    }
    let transactional = transactional_ddl(executor.dialect())
    if transactional {
        let _ = run_sql(executor, "BEGIN")?
    }
    for statement in item.down_statements {
        match run_sql(executor, statement) {
            case Ok(result) {}
            case Err(e) {
                if transactional {
                    rollback_quietly(executor)
                }
                return Err(e)
            }
        }
    }
    match delete_all(
        executor,
        delete_from("nest_migrations").where_eq("version", integer(item.version)),
    ) {
        case Ok(result) {}
        case Err(e) {
            if transactional {
                rollback_quietly(executor)
            }
            return Err(e)
        }
    }
    if transactional {
        let _ = run_sql(executor, "COMMIT")?
    }
    return Ok(true)
}

fun rollback_last[T: Executor](
    executor: T,
    migrations: list[Migration],
) -> Result[RollbackReport, Error] {
    let _ = validate_migrations(migrations)?
    let _ = ensure_migration_table(executor)?
    let columns: list[str] = ["version", "name"]
    let result = executor.run(
        raw_query(
            "SELECT version, name FROM nest_migrations ORDER BY version DESC LIMIT 1",
            empty_params(),
            columns,
            true,
        ),
    )?
    if result.rows.len() == 0 {
        return Ok(RollbackReport(rolled_back: None))
    }
    let version = parse_migration_version(result.rows[0].get(0))?
    let item = require_migration(migrations, version)?
    let _ = rollback_one(executor, item)?
    return Ok(RollbackReport(rolled_back: Some(version)))
}
