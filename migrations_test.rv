from std.test import assert_eq_int, assert_msg, assert_true
from "github.com/martian56/raven-sqlite" import Db as SqliteDb
from "./lib" import Executor, raw_query
from "./migrations" import (
    Migration,
    migrate,
    migration,
    rollback_last,
    split_statements,
    validate_migrations,
)
from "./sqlite" import Sqlite, sqlite

fun open_memory_db() -> Sqlite {
    return match SqliteDb.open(":memory:") {
        case Ok(connection) { sqlite(connection) }
        case Err(message) {
            __panic(message)
            open_memory_db()
        }
    }
}

fun must_migration[T](result: Result[T, Error]) -> T {
    return match result {
        case Ok(value) { value }
        case Err(e) {
            __panic(e.message())
            must_migration(result)
        }
    }
}

fun int_or(value: Option[int], fallback: int) -> int {
    return match value {
        case Some(inner) { inner }
        case None { fallback }
    }
}

fun project_migrations() -> list[Migration] {
    return [
        migration(1, "create projects").up(
            "CREATE TABLE projects (id INTEGER PRIMARY KEY, name TEXT NOT NULL)",
        ).down("DROP TABLE projects"),
        migration(2, "index project names").up("CREATE INDEX projects_name_idx ON projects (name)").down(
            "DROP INDEX projects_name_idx",
        ),
    ]
}

fun test_migrations_apply_once_and_track_versions() {
    let db = open_memory_db()
    let first = must_migration(migrate(db, project_migrations()))
    assert_eq_int(first.applied.len(), 2)
    assert_eq_int(first.applied[0], 1)
    assert_eq_int(first.applied[1], 2)
    assert_eq_int(first.skipped, 0)

    let second = must_migration(migrate(db, project_migrations()))
    assert_eq_int(second.applied.len(), 0)
    assert_eq_int(second.skipped, 2)
    db.close()
}

fun test_rollback_last_reverts_one_migration_at_a_time() {
    let db = open_memory_db()
    let migrations = project_migrations()
    let _ = must_migration(migrate(db, migrations))
    let second = must_migration(rollback_last(db, migrations))
    match second.rolled_back {
        case Some(version) { assert_eq_int(version, 2) }
        case None { assert_msg(false, "expected migration 2 to roll back") }
    }
    let first = must_migration(rollback_last(db, migrations))
    match first.rolled_back {
        case Some(version) { assert_eq_int(version, 1) }
        case None { assert_msg(false, "expected migration 1 to roll back") }
    }
    let empty = must_migration(rollback_last(db, migrations))
    match empty.rolled_back {
        case Some(version) { assert_msg(false, "nothing should remain to roll back") }
        case None { assert_true(true) }
    }
    db.close()
}

fun test_failed_sqlite_migration_rolls_back_transaction() {
    let db = open_memory_db()
    let migrations = [
        migration(1, "broken").up("CREATE TABLE should_not_exist (id INTEGER)").up(
            "THIS IS NOT SQL",
        ).down("DROP TABLE should_not_exist"),
    ]
    match migrate(db, migrations) {
        case Ok(report) { assert_msg(false, "broken migration unexpectedly succeeded") }
        case Err(e) { assert_true(e.message().length() > 0) }
    }
    let params: list[Option[str]] = []
    let columns: list[str] = ["count"]
    let result = must_migration(
        db.run(
            raw_query(
                "SELECT COUNT(*) AS count FROM sqlite_master WHERE type = 'table' AND name = 'should_not_exist'",
                params,
                columns,
                true,
            ),
        ),
    )
    assert_eq_int(int_or(result.rows[0].get(0).parse_int(), -1), 0)
    db.close()
}

fun test_migration_validation_rejects_unsafe_sequences() {
    match validate_migrations([migration(0, "zero").up("SELECT 1")]) {
        case Ok(value) { assert_msg(false, "zero version unexpectedly validated") }
        case Err(e) { assert_true(e.message().contains("positive")) }
    }
    match validate_migrations(
        [migration(2, "second").up("SELECT 1"), migration(1, "first").up("SELECT 1")],
    ) {
        case Ok(value) { assert_msg(false, "out-of-order migrations unexpectedly validated") }
        case Err(e) { assert_true(e.message().contains("ordered")) }
    }
    match validate_migrations([migration(1, "empty")]) {
        case Ok(value) { assert_msg(false, "statement-less migration unexpectedly validated") }
        case Err(e) { assert_true(e.message().contains("no up statements")) }
    }
}

fun test_migrate_rejects_changed_or_missing_applied_history() {
    let db = open_memory_db()
    let original = [
        migration(1, "create audit table").up(
            "CREATE TABLE migration_audit (id INTEGER PRIMARY KEY)",
        ).down("DROP TABLE migration_audit"),
    ]
    let _ = must_migration(migrate(db, original))

    let renamed = [migration(1, "renamed after release").up("SELECT 1").down("SELECT 1")]
    match migrate(db, renamed) {
        case Ok(_) { assert_msg(false, "renamed applied migration unexpectedly passed") }
        case Err(e) { assert_msg(e.message().contains("named"), e.message()) }
    }

    let missing: list[Migration] = []
    match migrate(db, missing) {
        case Ok(_) { assert_msg(false, "missing applied migration unexpectedly passed") }
        case Err(e) { assert_msg(e.message().contains("missing"), e.message()) }
    }
    db.close()
}

fun test_split_statements_respects_quotes_comments_and_dollar_bodies() {
    let sql = "CREATE TABLE a (x TEXT DEFAULT 'a;b'); -- c;d\nCREATE TABLE \"we;ird\" (y INT);; /* e;f */ CREATE FUNCTION g() RETURNS INT AS $body$ SELECT 1; $body$ LANGUAGE sql;\n"
    let parts = split_statements(sql)
    assert_eq_int(parts.len(), 3)
    assert_true(parts[0].contains("'a;b'"))
    assert_true(parts[1].starts_with("-- c;d") and parts[1].contains("we;ird"))
    assert_true(parts[2].contains("SELECT 1;"))
    assert_eq_int(split_statements("  ;  ; ").len(), 0)
    assert_eq_int(migration(1, "x").up("A; B;").up("C").up_statements.len(), 3)
}
