// Nest ORM core.
//
// Nest keeps SQL construction independent from database drivers. Queries are
// compiled for a Dialect and executed by any type implementing Executor.

//   import "github.com/martian56/nest-orm" { select, text, fetch_all }
//   import "github.com/martian56/nest-orm/sqlite" { sqlite }
//
//   let users = fetch_all(sqlite(db), select("users").column("name"))?

// Drivers can live in this repository or in third-party packages. A new
// backend only needs a small Executor wrapper around its Raven database client.

import std/error { error_kind }
import std/string

enum Dialect {
    Postgres,
    MySql,
    Sqlite,
}

impl Dialect {
    fun placeholder(self, index: Int) -> String {
        return match self {
            Postgres -> "$${index}",
            MySql -> "?",
            Sqlite -> "?",
        }
    }

    fun identifier_quote(self) -> String {
        return match self {
            Postgres -> "\"",
            MySql -> "`",
            Sqlite -> "\"",
        }
    }
}

// A database value accepted by every bundled Nest adapter. Drivers receive
// values separately from SQL, so values never become SQL syntax.
enum Value {
    Null,
    Text(String),
    Integer(Int),
    Decimal(Float),
    Boolean(Bool),
}

impl Value {
    fun parameter(self) -> Option<String> {
        return match self {
            Null -> None,
            Text(value) -> Some(value),
            Integer(value) -> Some("${value}"),
            Decimal(value) -> Some("${value}"),
            Boolean(value) -> {
                if value {
                    Some("true")
                } else {
                    Some("false")
                }
            },
        }
    }
}

fun null() -> Value = Value.Null
fun text(value: String) -> Value = Value.Text(value)
fun integer(value: Int) -> Value = Value.Integer(value)
fun decimal(value: Float) -> Value = Value.Decimal(value)
fun boolean(value: Bool) -> Value = Value.Boolean(value)

// A backend-neutral result row. Values preserve SQL NULL separately from an
// empty string. Named lookups use the column labels returned by the database.
struct Row {
    columns: List<String>,
    values: List<String>,
    nulls: List<Bool>,
}

impl Row {
    fun get(self, index: Int) -> String {
        return self.values[index]
    }

    fun is_null(self, index: Int) -> Bool {
        return self.nulls[index]
    }

    fun index_of(self, name: String) -> Option<Int> {
        let i = 0
        while i < self.columns.len() {
            if self.columns[i] == name {
                return Some(i)
            }
            i = i + 1
        }
        return None
    }

    fun get_named(self, name: String) -> Option<String> {
        return match self.index_of(name) {
            Some(index) -> {
                if self.nulls[index] {
                    None
                } else {
                    Some(self.values[index])
                }
            },
            None -> None,
        }
    }

    fun is_null_named(self, name: String) -> Bool {
        return match self.index_of(name) {
            Some(index) -> self.nulls[index],
            None -> false,
        }
    }

    fun optional(self, name: String) -> Result<Option<String>, Error> {
        return match self.index_of(name) {
            Some(index) -> {
                if self.nulls[index] {
                    Ok(None)
                } else {
                    Ok(Some(self.values[index]))
                }
            },
            None -> Err(error_kind("nest", "column ${name} is missing")),
        }
    }

    fun required(self, name: String) -> Result<String, Error> {
        return match self.optional(name)? {
            Some(value) -> Ok(value),
            None -> Err(error_kind("nest", "column ${name} is NULL")),
        }
    }

    fun int_named(self, name: String) -> Result<Int, Error> {
        let value = self.required(name)?
        return match value.parse_int() {
            Some(parsed) -> Ok(parsed),
            None -> Err(error_kind("nest", "column ${name} is not an integer")),
        }
    }

    fun float_named(self, name: String) -> Result<Float, Error> {
        let value = self.required(name)?
        return match value.parse_float() {
            Some(parsed) -> Ok(parsed),
            None -> Err(error_kind("nest", "column ${name} is not a float")),
        }
    }

    fun bool_named(self, name: String) -> Result<Bool, Error> {
        let value = self.required(name)?.to_lower()
        if value == "true" || value == "t" || value == "1" {
            return Ok(true)
        }
        if value == "false" || value == "f" || value == "0" {
            return Ok(false)
        }
        return Err(error_kind("nest", "column ${name} is not a boolean"))
    }
}

struct QueryResult {
    columns: List<String>,
    rows: List<Row>,
    affected: Int,
    last_insert_id: Int,
}

impl QueryResult {
    fun row_count(self) -> Int = self.rows.len()
}

// Models opt into decoding explicitly, so mappings stay compile-time checked
// without runtime reflection. A future derive can generate this same trait.
trait FromRow {
    fun from_row(row: Row) -> Result<Self, Error>
}

fun decode_row<T: FromRow>(row: Row) -> Result<T, Error> {
    return T.from_row(row)
}

fun map_rows<T: FromRow>(result: QueryResult) -> Result<List<T>, Error> {
    let models: List<T> = []
    for row in result.rows {
        models.push(T.from_row(row)?)
    }
    return Ok(models)
}

// The only contract required from a database adapter.
trait Executor {
    fun dialect(self) -> Dialect

    fun run(self, query: CompiledQuery) -> Result<QueryResult, Error>
}

struct CompiledQuery {
    sql: String,
    params: List<Option<String>>,
    columns: List<String>,
    returns_rows: Bool,
}

fun raw_query(
    sql: String,
    params: List<Option<String>>,
    columns: List<String>,
    returns_rows: Bool,
) -> CompiledQuery {
    return CompiledQuery { sql, params, columns, returns_rows }
}

struct SelectField {
    name: String,
    alias: Option<String>,
}

struct Condition {
    connector: String,
    column: String,
    operator: String,
    value: Option<Value>,
    values: List<Value>,
}

struct Ordering {
    column: String,
    direction: String,
}

struct Join {
    kind: String,
    table: String,
    left: String,
    right: String,
}

struct SelectQuery {
    table: String,
    fields: List<SelectField>,
    joins: List<Join>,
    conditions: List<Condition>,
    orderings: List<Ordering>,
    limit_value: Option<Int>,
    offset_value: Option<Int>,
}

fun select(table: String) -> SelectQuery {
    let fields: List<SelectField> = []
    let joins: List<Join> = []
    let conditions: List<Condition> = []
    let orderings: List<Ordering> = []
    return SelectQuery {
        table,
        fields,
        joins,
        conditions,
        orderings,
        limit_value: None,
        offset_value: None,
    }
}

impl SelectQuery {
    fun column(self, name: String) -> SelectQuery {
        self.fields.push(SelectField { name, alias: None })
        return self
    }

    fun column_as(self, name: String, alias: String) -> SelectQuery {
        self.fields.push(SelectField { name, alias: Some(alias) })
        return self
    }

    fun inner_join(self, table: String, left: String, right: String) -> SelectQuery {
        self.joins.push(Join { kind: "INNER", table, left, right })
        return self
    }

    fun left_join(self, table: String, left: String, right: String) -> SelectQuery {
        self.joins.push(Join { kind: "LEFT", table, left, right })
        return self
    }

    fun where_eq(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("AND", column, "=", value))
        return self
    }

    fun or_where_eq(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("OR", column, "=", value))
        return self
    }

    fun where_not_eq(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("AND", column, "<>", value))
        return self
    }

    fun where_gt(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("AND", column, ">", value))
        return self
    }

    fun where_gte(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("AND", column, ">=", value))
        return self
    }

    fun where_lt(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("AND", column, "<", value))
        return self
    }

    fun where_lte(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("AND", column, "<=", value))
        return self
    }

    fun where_like(self, column: String, value: Value) -> SelectQuery {
        self.conditions.push(value_condition("AND", column, "LIKE", value))
        return self
    }

    fun where_null(self, column: String) -> SelectQuery {
        self.conditions.push(null_condition("AND", column, "IS NULL"))
        return self
    }

    fun where_not_null(self, column: String) -> SelectQuery {
        self.conditions.push(null_condition("AND", column, "IS NOT NULL"))
        return self
    }

    fun where_in(self, column: String, values: List<Value>) -> SelectQuery {
        self.conditions.push(in_condition("AND", column, "IN", values))
        return self
    }

    fun where_not_in(self, column: String, values: List<Value>) -> SelectQuery {
        self.conditions.push(in_condition("AND", column, "NOT IN", values))
        return self
    }

    fun order_asc(self, column: String) -> SelectQuery {
        self.orderings.push(Ordering { column, direction: "ASC" })
        return self
    }

    fun order_desc(self, column: String) -> SelectQuery {
        self.orderings.push(Ordering { column, direction: "DESC" })
        return self
    }

    fun limit(self, count: Int) -> SelectQuery {
        self.limit_value = Some(count)
        return self
    }

    fun offset(self, count: Int) -> SelectQuery {
        self.offset_value = Some(count)
        return self
    }

    fun compile(self, dialect: Dialect) -> Result<CompiledQuery, Error> {
        let sql = "SELECT "
        let columns: List<String> = []
        if self.fields.len() == 0 {
            sql = sql.concat("*")
        } else {
            let i = 0
            while i < self.fields.len() {
                if i > 0 {
                    sql = sql.concat(", ")
                }
                let field = self.fields[i]
                sql = sql.concat(quote_identifier(field.name, dialect)?)
                match field.alias {
                    Some(alias) -> {
                        sql = sql.concat(" AS ").concat(quote_identifier(alias, dialect)?)
                        columns.push(alias)
                    },
                    None -> columns.push(last_identifier_segment(field.name)),
                }
                i = i + 1
            }
        }
        sql = sql.concat(" FROM ").concat(quote_identifier(self.table, dialect)?)
        for join in self.joins {
            sql = sql.concat(" ${join.kind} JOIN ")
            sql = sql.concat(quote_identifier(join.table, dialect)?)
            sql = sql.concat(" ON ").concat(quote_identifier(join.left, dialect)?)
            sql = sql.concat(" = ").concat(quote_identifier(join.right, dialect)?)
        }
        let compiled_conditions = compile_conditions(self.conditions, dialect, 1)?
        sql = sql.concat(compiled_conditions.sql)
        if self.orderings.len() > 0 {
            sql = sql.concat(" ORDER BY ")
            let i = 0
            while i < self.orderings.len() {
                if i > 0 {
                    sql = sql.concat(", ")
                }
                let ordering = self.orderings[i]
                sql = sql.concat(quote_identifier(ordering.column, dialect)?)
                sql = sql.concat(" ").concat(ordering.direction)
                i = i + 1
            }
        }
        match self.limit_value {
            Some(count) -> {
                if count < 0 {
                    return Err(error_kind("nest", "limit cannot be negative"))
                }
                sql = sql.concat(" LIMIT ${count}")
            },
            None -> {},
        }
        match self.offset_value {
            Some(count) -> {
                if count < 0 {
                    return Err(error_kind("nest", "offset cannot be negative"))
                }
                sql = sql.concat(" OFFSET ${count}")
            },
            None -> {},
        }
        return Ok(
            CompiledQuery {
                sql,
                params: compiled_conditions.params,
                columns,
                returns_rows: true,
            },
        )
    }
}

struct Assignment {
    column: String,
    value: Value,
}

struct InsertQuery {
    table: String,
    values: List<Assignment>,
    returning: List<String>,
}

fun insert_into(table: String) -> InsertQuery {
    let values: List<Assignment> = []
    let returning: List<String> = []
    return InsertQuery { table, values, returning }
}

impl InsertQuery {
    fun value(self, column: String, value: Value) -> InsertQuery {
        self.values.push(Assignment { column, value })
        return self
    }

    // Return `column` from the inserted row (PostgreSQL and SQLite). Chain it to
    // read a generated id without a follow-up query. MySQL has no RETURNING;
    // compile rejects it there so the mistake surfaces before the round trip.
    fun returning(self, column: String) -> InsertQuery {
        self.returning.push(column)
        return self
    }

    fun compile(self, dialect: Dialect) -> Result<CompiledQuery, Error> {
        if self.values.len() == 0 {
            return Err(error_kind("nest", "insert requires at least one value"))
        }
        let sql = "INSERT INTO ".concat(quote_identifier(self.table, dialect)?).concat(" (")
        let params: List<Option<String>> = []
        let i = 0
        while i < self.values.len() {
            if i > 0 {
                sql = sql.concat(", ")
            }
            sql = sql.concat(quote_identifier(self.values[i].column, dialect)?)
            i = i + 1
        }
        sql = sql.concat(") VALUES (")
        let i = 0
        while i < self.values.len() {
            if i > 0 {
                sql = sql.concat(", ")
            }
            sql = sql.concat(dialect.placeholder(i + 1))
            params.push(self.values[i].value.parameter())
            i = i + 1
        }
        sql = sql.concat(")")
        let columns: List<String> = []
        let returns_rows = false
        if self.returning.len() > 0 {
            let mysql = match dialect {
                MySql -> true,
                Postgres -> false,
                Sqlite -> false,
            }
            if mysql {
                return Err(error_kind("nest", "MySQL does not support RETURNING"))
            }
            sql = sql.concat(" RETURNING ")
            let r = 0
            while r < self.returning.len() {
                if r > 0 {
                    sql = sql.concat(", ")
                }
                sql = sql.concat(quote_identifier(self.returning[r], dialect)?)
                columns.push(last_identifier_segment(self.returning[r]))
                r = r + 1
            }
            returns_rows = true
        }
        return Ok(CompiledQuery { sql, params, columns, returns_rows })
    }
}

struct UpdateQuery {
    table: String,
    assignments: List<Assignment>,
    conditions: List<Condition>,
}

fun update(table: String) -> UpdateQuery {
    let assignments: List<Assignment> = []
    let conditions: List<Condition> = []
    return UpdateQuery { table, assignments, conditions }
}

impl UpdateQuery {
    fun set(self, column: String, value: Value) -> UpdateQuery {
        self.assignments.push(Assignment { column, value })
        return self
    }

    fun where_eq(self, column: String, value: Value) -> UpdateQuery {
        self.conditions.push(value_condition("AND", column, "=", value))
        return self
    }

    fun where_null(self, column: String) -> UpdateQuery {
        self.conditions.push(null_condition("AND", column, "IS NULL"))
        return self
    }

    fun compile(self, dialect: Dialect) -> Result<CompiledQuery, Error> {
        if self.assignments.len() == 0 {
            return Err(error_kind("nest", "update requires at least one assignment"))
        }
        let sql = "UPDATE ".concat(quote_identifier(self.table, dialect)?).concat(" SET ")
        let params: List<Option<String>> = []
        let i = 0
        while i < self.assignments.len() {
            if i > 0 {
                sql = sql.concat(", ")
            }
            sql = sql.concat(quote_identifier(self.assignments[i].column, dialect)?)
            sql = sql.concat(" = ").concat(dialect.placeholder(i + 1))
            params.push(self.assignments[i].value.parameter())
            i = i + 1
        }
        let compiled_conditions = compile_conditions(
            self.conditions,
            dialect,
            self.assignments.len() + 1,
        )?
        sql = sql.concat(compiled_conditions.sql)
        for param in compiled_conditions.params {
            params.push(param)
        }
        let columns: List<String> = []
        return Ok(CompiledQuery { sql, params, columns, returns_rows: false })
    }
}

struct DeleteQuery {
    table: String,
    conditions: List<Condition>,
}

fun delete_from(table: String) -> DeleteQuery {
    let conditions: List<Condition> = []
    return DeleteQuery { table, conditions }
}

impl DeleteQuery {
    fun where_eq(self, column: String, value: Value) -> DeleteQuery {
        self.conditions.push(value_condition("AND", column, "=", value))
        return self
    }

    fun where_null(self, column: String) -> DeleteQuery {
        self.conditions.push(null_condition("AND", column, "IS NULL"))
        return self
    }

    fun compile(self, dialect: Dialect) -> Result<CompiledQuery, Error> {
        let sql = "DELETE FROM ".concat(quote_identifier(self.table, dialect)?)
        let compiled_conditions = compile_conditions(self.conditions, dialect, 1)?
        sql = sql.concat(compiled_conditions.sql)
        let columns: List<String> = []
        return Ok(
            CompiledQuery {
                sql,
                params: compiled_conditions.params,
                columns,
                returns_rows: false,
            },
        )
    }
}

struct ConditionSql {
    sql: String,
    params: List<Option<String>>,
}

fun no_values() -> List<Value> {
    let values: List<Value> = []
    return values
}

fun value_condition(
    connector: String,
    column: String,
    operator: String,
    value: Value,
) -> Condition {
    return Condition { connector, column, operator, value: Some(value), values: no_values() }
}

fun null_condition(connector: String, column: String, operator: String) -> Condition {
    return Condition { connector, column, operator, value: None, values: no_values() }
}

fun in_condition(
    connector: String,
    column: String,
    operator: String,
    values: List<Value>,
) -> Condition {
    return Condition { connector, column, operator, value: None, values }
}

fun compile_conditions(
    conditions: List<Condition>,
    dialect: Dialect,
    start_index: Int,
) -> Result<ConditionSql, Error> {
    let sql = ""
    let params: List<Option<String>> = []
    let i = 0
    while i < conditions.len() {
        let condition = conditions[i]
        if i == 0 {
            sql = sql.concat(" WHERE ")
        } else {
            sql = sql.concat(" ${condition.connector} ")
        }
        sql = sql.concat(quote_identifier(condition.column, dialect)?)
        sql = sql.concat(" ").concat(condition.operator)
        if condition.operator == "IN" || condition.operator == "NOT IN" {
            // An empty list can never match, so IN (NULL) yields no rows rather
            // than the invalid IN ().
            if condition.values.len() == 0 {
                sql = sql.concat(" (NULL)")
            } else {
                sql = sql.concat(" (")
                let j = 0
                while j < condition.values.len() {
                    if j > 0 {
                        sql = sql.concat(", ")
                    }
                    sql = sql.concat(dialect.placeholder(start_index + params.len()))
                    params.push(condition.values[j].parameter())
                    j = j + 1
                }
                sql = sql.concat(")")
            }
        } else {
            match condition.value {
                Some(value) -> {
                    sql = sql.concat(" ").concat(dialect.placeholder(start_index + params.len()))
                    params.push(value.parameter())
                },
                None -> {},
            }
        }
        i = i + 1
    }
    return Ok(ConditionSql { sql, params })
}

fun last_identifier_segment(identifier: String) -> String {
    let parts = identifier.split(".")
    return parts[parts.len() - 1]
}

fun valid_identifier_segment(segment: String, allow_star: Bool) -> Bool {
    if allow_star && segment == "*" {
        return true
    }
    if segment.length() == 0 {
        return false
    }
    let i = 0
    while i < segment.length() {
        let byte = __str_byte_at(segment, i)
        let alpha = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        let digit = byte >= 48 && byte <= 57
        if !(alpha || digit || byte == 95) {
            return false
        }
        if i == 0 && digit {
            return false
        }
        i = i + 1
    }
    return true
}

fun quote_identifier(identifier: String, dialect: Dialect) -> Result<String, Error> {
    let parts = identifier.split(".")
    if parts.len() == 0 {
        return Err(error_kind("nest", "identifier cannot be empty"))
    }
    let quote = dialect.identifier_quote()
    let out = ""
    let i = 0
    while i < parts.len() {
        let part = parts[i]
        if !valid_identifier_segment(part, i == parts.len() - 1) {
            return Err(error_kind("nest", "invalid SQL identifier: ${identifier}"))
        }
        if i > 0 {
            out = out.concat(".")
        }
        if part == "*" {
            out = out.concat("*")
        } else {
            out = out.concat(quote).concat(part).concat(quote)
        }
        i = i + 1
    }
    return Ok(out)
}

fun fetch_all<T: Executor>(executor: T, query: SelectQuery) -> Result<QueryResult, Error> {
    return executor.run(query.compile(executor.dialect())?)
}

fun insert_one<T: Executor>(executor: T, query: InsertQuery) -> Result<QueryResult, Error> {
    return executor.run(query.compile(executor.dialect())?)
}

fun update_all<T: Executor>(executor: T, query: UpdateQuery) -> Result<QueryResult, Error> {
    return executor.run(query.compile(executor.dialect())?)
}

fun delete_all<T: Executor>(executor: T, query: DeleteQuery) -> Result<QueryResult, Error> {
    return executor.run(query.compile(executor.dialect())?)
}

fun empty_param_list() -> List<Option<String>> {
    let params: List<Option<String>> = []
    return params
}

fun empty_column_list() -> List<String> {
    let columns: List<String> = []
    return columns
}

// Transaction control. BEGIN, COMMIT, and ROLLBACK are accepted by all three
// bundled dialects (MySQL treats BEGIN as START TRANSACTION).
fun begin<T: Executor>(executor: T) -> Result<QueryResult, Error> {
    return executor.run(raw_query("BEGIN", empty_param_list(), empty_column_list(), false))
}

fun commit<T: Executor>(executor: T) -> Result<QueryResult, Error> {
    return executor.run(raw_query("COMMIT", empty_param_list(), empty_column_list(), false))
}

fun rollback<T: Executor>(executor: T) -> Result<QueryResult, Error> {
    return executor.run(raw_query("ROLLBACK", empty_param_list(), empty_column_list(), false))
}

// Run `body` inside a transaction: BEGIN, then COMMIT on Ok, or ROLLBACK on Err
// (the original error is preserved). The rollback is best effort, so a failed
// body still surfaces its own error rather than a rollback error.
fun transaction<T: Executor, R>(executor: T, body: fun(T) -> Result<R, Error>) -> Result<R, Error> {
    begin(executor)?
    return match body(executor) {
        Ok(value) -> {
            commit(executor)?
            Ok(value)
        },
        Err(error) -> {
            let _ = rollback(executor)
            Err(error)
        },
    }
}
