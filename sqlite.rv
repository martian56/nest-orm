// SQLite adapter for Nest.

import std/error { error_kind }
import std/string
import "github.com/martian56/raven-sqlite" { Db as SqliteDb, Stmt as SqliteStmt }
import "./lib" { CompiledQuery, Dialect, Executor, QueryResult as NestQueryResult, Row as NestRow }

struct Sqlite {
    connection: SqliteDb,
}

fun sqlite(connection: SqliteDb) -> Sqlite {
    return Sqlite { connection }
}

impl Sqlite {
    fun try_close(self) -> Result<Bool, Error> {
        return match self.connection.try_close() {
            Ok(closed) -> Ok(closed),
            Err(message) -> Err(error_kind("sqlite", message)),
        }
    }

    fun close(self) {
        let _ = self.try_close()
    }
}

impl Executor for Sqlite {
    fun dialect(self) -> Dialect = Dialect.Sqlite

    fun run(self, query: CompiledQuery) -> Result<NestQueryResult, Error> {
        let statement = prepare_sqlite(self.connection, query.sql)?
        match bind_sqlite(statement, query.params) {
            Ok(_) -> {},
            Err(e) -> {
                finalize_sqlite_quietly(statement)
                return Err(e)
            },
        }
        if query.returns_rows {
            return read_sqlite_rows(self.connection, statement, query.columns)
        }
        match statement.next() {
            Ok(has_row) -> {
                if has_row {
                    finalize_sqlite_quietly(statement)
                    return Err(error_kind("sqlite", "query returned rows but was not marked as row-returning"))
                }
            },
            Err(message) -> {
                finalize_sqlite_quietly(statement)
                return Err(error_kind("sqlite", message))
            },
        }
        match statement.try_finalize() {
            Ok(_) -> {},
            Err(message) -> {
                return Err(error_kind("sqlite", message))
            },
        }
        let columns: List<String> = []
        let rows: List<NestRow> = []
        return Ok(
            NestQueryResult {
                columns,
                rows,
                affected: self.connection.changes(),
                last_insert_id: self.connection.last_insert_id(),
            },
        )
    }
}

fun prepare_sqlite(connection: SqliteDb, sql: String) -> Result<SqliteStmt, Error> {
    return match connection.prepare(sql) {
        Ok(value) -> Ok(value),
        Err(message) -> Err(error_kind("sqlite", message)),
    }
}

fun bind_sqlite(statement: SqliteStmt, params: List<Option<String>>) -> Result<Bool, Error> {
    if params.len() != statement.parameter_count() {
        return Err(
            error_kind(
                "sqlite",
                "expected ${statement.parameter_count()} parameters, got ${params.len()}",
            ),
        )
    }
    let i = 0
    while i < params.len() {
        match params[i] {
            Some(value) -> {
                match statement.try_bind_text(i + 1, value) {
                    Ok(_) -> {},
                    Err(message) -> {
                        return Err(error_kind("sqlite", message))
                    },
                }
            },
            None -> {
                match statement.try_bind_null(i + 1) {
                    Ok(_) -> {},
                    Err(message) -> {
                        return Err(error_kind("sqlite", message))
                    },
                }
            },
        }
        i = i + 1
    }
    return Ok(true)
}

fun finalize_sqlite_quietly(statement: SqliteStmt) {
    let _ = statement.try_finalize()
}

fun sqlite_columns(statement: SqliteStmt, expected: List<String>) -> List<String> {
    if expected.len() > 0 && expected.len() == statement.column_count() {
        return expected
    }
    let columns: List<String> = []
    let i = 0
    while i < statement.column_count() {
        columns.push(statement.column_name(i))
        i = i + 1
    }
    return columns
}

fun read_sqlite_rows(
    connection: SqliteDb,
    statement: SqliteStmt,
    expected_columns: List<String>,
) -> Result<NestQueryResult, Error> {
    let columns = sqlite_columns(statement, expected_columns)
    let rows: List<NestRow> = []
    let reading = true
    while reading {
        match statement.next() {
            Ok(has_row) -> {
                reading = has_row
            },
            Err(message) -> {
                finalize_sqlite_quietly(statement)
                return Err(error_kind("sqlite", message))
            },
        }
        if !reading {
            break
        }
        let values: List<String> = []
        let nulls: List<Bool> = []
        let i = 0
        while i < statement.column_count() {
            let is_null = match statement.try_is_null(i) {
                Ok(value) -> value,
                Err(message) -> {
                    finalize_sqlite_quietly(statement)
                    return Err(error_kind("sqlite", message))
                    false
                },
            }
            if is_null {
                values.push("")
                nulls.push(true)
            } else {
                let value = match statement.try_text(i) {
                    Ok(text) -> text,
                    Err(message) -> {
                        finalize_sqlite_quietly(statement)
                        return Err(error_kind("sqlite", message))
                        ""
                    },
                }
                values.push(value)
                nulls.push(false)
            }
            i = i + 1
        }
        rows.push(NestRow { columns, values, nulls })
    }
    match statement.try_finalize() {
        Ok(_) -> {},
        Err(message) -> {
            return Err(error_kind("sqlite", message))
        },
    }
    return Ok(
        NestQueryResult {
            columns,
            rows,
            affected: connection.changes(),
            last_insert_id: connection.last_insert_id(),
        },
    )
}
