// SQLite adapter for Nest.

from std.error import error_kind
import std.string
from "github.com/martian56/raven-sqlite" import Db as SqliteDb, Stmt as SqliteStmt
from "./lib" import CompiledQuery, Dialect, Executor, QueryResult as NestQueryResult, Row as NestRow

class Sqlite {
    connection: SqliteDb
}

fun sqlite(connection: SqliteDb) -> Sqlite {
    return Sqlite(connection: connection)
}

impl Sqlite {
    fun try_close(self) -> Result[bool, Error] {
        return match self.connection.try_close() {
            case Ok(closed) { Ok(closed) }
            case Err(message) { Err(error_kind("sqlite", message)) }
        }
    }
}

impl Executor for Sqlite {
    fun dialect(self) -> Dialect = Dialect.Sqlite

    fun close(self) {
        let _ = self.try_close()
    }

    fun run(self, query: CompiledQuery) -> Result[NestQueryResult, Error] {
        let statement = prepare_sqlite(self.connection, query.sql)?
        match bind_sqlite(statement, query.params) {
            case Ok(_) {}
            case Err(e) {
                finalize_sqlite_quietly(statement)
                return Err(e)
            }
        }
        if query.returns_rows {
            return read_sqlite_rows(self.connection, statement, query.columns)
        }
        match statement.next() {
            case Ok(has_row) {
                if has_row {
                    finalize_sqlite_quietly(statement)
                    return Err(error_kind("sqlite", "query returned rows but was not marked as row-returning"))
                }
            }
            case Err(message) {
                finalize_sqlite_quietly(statement)
                return Err(error_kind("sqlite", message))
            }
        }
        match statement.try_finalize() {
            case Ok(_) {}
            case Err(message) {
                return Err(error_kind("sqlite", message))
            }
        }
        let columns: list[str] = []
        let rows: list[NestRow] = []
        return Ok(
            NestQueryResult(
                columns: columns,
                rows: rows,
                affected: self.connection.changes(),
                last_insert_id: self.connection.last_insert_id(),
            ),
        )
    }
}

fun prepare_sqlite(connection: SqliteDb, sql: str) -> Result[SqliteStmt, Error] {
    return match connection.prepare(sql) {
        case Ok(value) { Ok(value) }
        case Err(message) { Err(error_kind("sqlite", message)) }
    }
}

fun bind_sqlite(statement: SqliteStmt, params: list[Option[str]]) -> Result[bool, Error] {
    if params.len() != statement.parameter_count() {
        return Err(
            error_kind(
                "sqlite",
                "expected ${statement.parameter_count()} parameters, got ${params.len()}",
            ),
        )
    }
    var i = 0
    while i < params.len() {
        match params[i] {
            case Some(value) {
                match statement.try_bind_text(i + 1, value) {
                    case Ok(_) {}
                    case Err(message) {
                        return Err(error_kind("sqlite", message))
                    }
                }
            }
            case None {
                match statement.try_bind_null(i + 1) {
                    case Ok(_) {}
                    case Err(message) {
                        return Err(error_kind("sqlite", message))
                    }
                }
            }
        }
        i = i + 1
    }
    return Ok(true)
}

fun finalize_sqlite_quietly(statement: SqliteStmt) {
    let _ = statement.try_finalize()
}

fun sqlite_columns(statement: SqliteStmt, expected: list[str]) -> list[str] {
    if expected.len() > 0 and expected.len() == statement.column_count() {
        return expected
    }
    let columns: list[str] = []
    var i = 0
    while i < statement.column_count() {
        columns.push(statement.column_name(i))
        i = i + 1
    }
    return columns
}

fun read_sqlite_rows(
    connection: SqliteDb,
    statement: SqliteStmt,
    expected_columns: list[str],
) -> Result[NestQueryResult, Error] {
    let columns = sqlite_columns(statement, expected_columns)
    let rows: list[NestRow] = []
    var reading = true
    while reading {
        match statement.next() {
            case Ok(has_row) {
                reading = has_row
            }
            case Err(message) {
                finalize_sqlite_quietly(statement)
                return Err(error_kind("sqlite", message))
            }
        }
        if not reading {
            break
        }
        let values: list[str] = []
        let nulls: list[bool] = []
        var i = 0
        while i < statement.column_count() {
            let is_null = match statement.try_is_null(i) {
                case Ok(value) { value }
                case Err(message) {
                    finalize_sqlite_quietly(statement)
                    return Err(error_kind("sqlite", message))
                    false
                }
            }
            if is_null {
                values.push("")
                nulls.push(true)
            } else {
                let value = match statement.try_text(i) {
                    case Ok(text) { text }
                    case Err(message) {
                        finalize_sqlite_quietly(statement)
                        return Err(error_kind("sqlite", message))
                        ""
                    }
                }
                values.push(value)
                nulls.push(false)
            }
            i = i + 1
        }
        rows.push(NestRow(columns: columns, values: values, nulls: nulls))
    }
    match statement.try_finalize() {
        case Ok(_) {}
        case Err(message) {
            return Err(error_kind("sqlite", message))
        }
    }
    return Ok(
        NestQueryResult(
            columns: columns,
            rows: rows,
            affected: connection.changes(),
            last_insert_id: connection.last_insert_id(),
        ),
    )
}
