// PostgreSQL adapter for Nest.

from "github.com/martian56/raven-postgres" import (
    Connection as PostgresConnection,
    QueryResult as PostgresQueryResult,
)
from "./lib" import CompiledQuery, Dialect, Executor, QueryResult as NestQueryResult, Row as NestRow

class Postgres {
    connection: PostgresConnection
}

fun postgres(connection: PostgresConnection) -> Postgres {
    return Postgres(connection: connection)
}

impl Executor for Postgres {
    fun dialect(self) -> Dialect = Dialect.Postgres

    fun close(self) {
        self.connection.close()
    }

    // An ERROR response ends only the statement; FATAL and PANIC end the
    // session, and a protocol or network failure leaves the stream in an
    // unknown state. An error from the caller's own code (a transaction body
    // that gave up) says nothing about the connection.
    fun reusable_after(self, error: Error) -> bool {
        if error.kind == "postgres" {
            return error.message.starts_with("ERROR ")
        }
        return error.kind != "net" and error.kind != "tls" and error.kind != "io"
    }

    fun run(self, query: CompiledQuery) -> Result[NestQueryResult, Error] {
        let result = self.connection.query_optional_params(query.sql, query.params)?
        return Ok(postgres_result(result))
    }
}

fun postgres_result(result: PostgresQueryResult) -> NestQueryResult {
    let rows: list[NestRow] = []
    for row in result.rows {
        rows.push(NestRow(columns: result.columns, values: row.values, nulls: row.nulls))
    }
    return NestQueryResult(
        columns: result.columns,
        rows: rows,
        affected: result.affected,
        last_insert_id: 0,
    )
}
